crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# IMPORTANT: Files to track (negating the ignore)
# This ensures our important files are always tracked

# Scripts
!/[Aa]ssets/[Ss]cripts/**/*.cs
!/[Aa]ssets/[Ee]ditor/**/*.cs

# Unity scene files
!/[Aa]ssets/**/*.unity
!/[Aa]ssets/**/*.unity.meta

# Prefabs
!/[Aa]ssets/**/*.prefab
!/[Aa]ssets/**/*.prefab.meta

# Materials
!/[Aa]ssets/**/*.mat
!/[Aa]ssets/**/*.mat.meta

# Animation
!/[Aa]ssets/**/*.controller
!/[Aa]ssets/**/*.controller.meta
!/[Aa]ssets/**/*.anim
!/[Aa]ssets/**/*.anim.meta

# ScriptableObjects and other assets
!/[Aa]ssets/**/*.asset
!/[Aa]ssets/**/*.asset.meta

# Project settings
!/[Pp]roject[Ss]ettings/
!/[Pp]ackages/manifest.json
!/[Pp]ackages/packages-lock.json

# Documentation
!/README.md
!/GIT_GUIDE.md
!/[Dd]ocumentation/
